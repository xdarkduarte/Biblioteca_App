<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.biblioteca.controller.DashboardController"
            style="-fx-background-color: #121212;">

    <children>

        <VBox layoutX="0" layoutY="0"
              prefWidth="220"
              prefHeight="700"
              spacing="15"
              style="-fx-background-color:#181818;
                     -fx-padding:20;">

            <Button text="Utilizadores"
                    prefWidth="180"
                    style="-fx-background-color:#00CEC8;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;" />

            <Button text="Livros"
                    prefWidth="180"
                    style="-fx-background-color:#00CEC8;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;" />

            <Button text="Empréstimos"
                    prefWidth="180"
                    style="-fx-background-color:#00CEC8;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;" />

            <Button text="Notificações"
                    prefWidth="180"
                    style="-fx-background-color:#00CEC8;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;" />

        </VBox>

        <Label fx:id="lblTitulo"
               layoutX="280"
               layoutY="50"
               style="-fx-text-fill:white;
                      -fx-font-size:28px;
                      -fx-font-weight:bold;" />

    </children>

</AnchorPane>